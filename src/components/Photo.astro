---
// One responsive image.
//
// Three details matter here and each prevents a specific failure:
//
//  width/height   Reserves the right box before the bytes arrive, so the page
//                 does not jump as photos load. The single biggest cause of an
//                 image-heavy page feeling broken.
//  sizes          Tells the browser how wide the image will *render* so it can
//                 pick from srcset before layout exists. Get this wrong and it
//                 downloads a 1800px file to show at 400px.
//  placeholder    The ~500-byte inline preview from the pipeline, painted as a
//                 background under the transparent-until-loaded image.

import { asset } from '../lib/url.js';

const { photo, sizes = '(max-width: 900px) 100vw, 900px', eager = false, alt = '' } = Astro.props;

const srcset = photo.srcset.map((s) => `${asset(s.src)} ${s.w}w`).join(', ');
const fallback = photo.srcset[photo.srcset.length - 1];
---

<figure class="photo" style={`--w:${photo.width}; --h:${photo.height}`}>
  <img
    src={asset(fallback.src)}
    srcset={srcset}
    sizes={sizes}
    width={photo.width}
    height={photo.height}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : 'auto'}
    style={`background-image:url(${photo.placeholder})`}
  />
</figure>

<style>
  .photo {
    margin: 0;
  }

  .photo img {
    width: 100%;
    height: auto;
    aspect-ratio: var(--w) / var(--h);
    background-size: cover;
    background-position: center;
    /* A hairline frame plus a soft drop shadow. The border alone reads as flat
       on a dark ground; the shadow is what makes photos sit above the page. */
    border: 1px solid rgba(236, 234, 229, 0.14);
    border-radius: 3px;
    box-shadow: 0 2px 14px rgba(0, 0, 0, 0.45);
    cursor: zoom-in;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
    /* Fade in over the blurred placeholder rather than snapping. */
    animation: reveal 0.5s ease-out;
  }

  .photo img:hover {
    border-color: rgba(217, 164, 65, 0.55);
    box-shadow: 0 4px 22px rgba(0, 0, 0, 0.6);
    transform: translateY(-2px);
  }

  @keyframes reveal {
    from { opacity: 0.55; }
    to { opacity: 1; }
  }
</style>
