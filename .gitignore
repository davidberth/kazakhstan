# Full-resolution originals — never committed. Keep these in durable backup storage.
# Only optimized derivatives under public/photos/ belong in git.
photos/originals/*
!photos/originals/.gitkeep
photos/**/*.CR2
photos/**/*.NEF
photos/**/*.ARW
photos/**/*.dng
photos/**/*.heic
photos/**/*.HEIC

# Pipeline cache
.photo-cache/

# Node / Astro
node_modules/
dist/
.astro/
*.log
npm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Env
.env
.env.*
!.env.example
